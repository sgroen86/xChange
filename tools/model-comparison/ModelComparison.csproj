<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs a folder of invoice PDFs through several Claude models with the
    production extraction code, and compares fields, tokens, cost and time.
    Not part of the solution or CI: it calls the real API and costs money.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InvoicePlatform.Infrastructure\InvoicePlatform.Infrastructure.csproj" />
  </ItemGroup>
</Project>
