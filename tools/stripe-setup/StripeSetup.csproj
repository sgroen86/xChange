<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sets up xChange's products, prices, customer portal and webhook in a
    Stripe account, idempotently. Run once per account (test, then live) by
    the owner; not part of the solution or CI. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plans and lookup keys come from the same catalogue the API sells from. -->
    <ProjectReference Include="..\..\src\InvoicePlatform.Application\InvoicePlatform.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same version as InvoicePlatform.Infrastructure, so the webhook's API version matches the API's. -->
    <PackageReference Include="Stripe.net" Version="53.0.0" />
  </ItemGroup>
</Project>
