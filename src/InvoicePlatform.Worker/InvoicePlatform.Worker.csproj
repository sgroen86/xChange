<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The background worker: a Lambda function that consumes the import queue
    (SQS) and reads each PDF with the same extraction the API uses. Published
    as its own zip by .github/workflows/deploy-api.yml.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" Version="3.4.0" />
    <PackageReference Include="Amazon.Lambda.SimpleEmailEvents" Version="4.0.1" />
    <PackageReference Include="Amazon.Lambda.SQSEvents" Version="3.0.1" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoicePlatform.Application\InvoicePlatform.Application.csproj" />
    <ProjectReference Include="..\InvoicePlatform.Infrastructure\InvoicePlatform.Infrastructure.csproj" />
  </ItemGroup>
</Project>
